# Portas do docker compose no host (mude se já estiverem em uso)
POSTGRES_PORT=5432
EVOLUTION_PORT=8080

# Backend
PORT=3333
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm
SESSION_COOKIE_SECURE=false

# Storage de mídia: local (dev) | supabase (prod)
STORAGE_DRIVER=local
MEDIA_DIR=.media
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# Evolution API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE=v4-msco
EVOLUTION_WEBHOOK_TOKEN=troque-este-token
# URL pela qual a Evolution alcança o backend (webhook)
PUBLIC_BACKEND_URL=http://host.docker.internal:3333

# Frontend (rewrite /api -> backend)
BACKEND_URL=http://localhost:3333

# Relatórios de BI
# Cifra senhas/tokens das fontes de dados. Gere com: openssl rand -base64 32
BI_SECRETS_KEY=
# true só em dev (permite conectar ao Postgres/MySQL do docker compose); false em produção
BI_ALLOW_PRIVATE_NETWORKS=true
MYSQL_PORT=3306

# Cifra as chaves dos provedores de IA (feature 003): openssl rand -base64 32
AI_CREDENTIALS_KEY=
