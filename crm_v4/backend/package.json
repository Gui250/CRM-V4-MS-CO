{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../.env src/db/migrate.ts",
    "db:seed:perf": "tsx --env-file=../.env scripts/seed-conversations.ts",
    "db:seed:pipelines": "tsx --env-file=../.env scripts/seed-pipeline-leads.ts",
    "db:seed:bi": "tsx --env-file=../.env scripts/seed-bi-perf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
